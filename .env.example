# Copiar a .env y completar. El .env nunca va al repositorio y vive por
# encima del DocumentRoot: Apache no puede servirlo ni aunque se equivoque la
# configuración.
#
#   cp .env.example .env
#   chmod 600 .env
#   php bin/console migrate
#   php bin/console user:create --email=vos@dominio --name="Tu Nombre"

APP_ENV=production
APP_DEBUG=false
APP_URL=https://tu-dominio

# Los dos secretos de la instalación. Generá cada uno por separado con:
#   php -r 'echo bin2hex(random_bytes(32)), "\n";'
#
# APP_KEY     firma los desafíos antispam y cifra la clave SMTP guardada.
# HASH_PEPPER es lo que hace que los hashes de IP y de correo no se puedan
#             revertir con una tabla precalculada. Si cambia, la analítica
#             pierde la continuidad de visitantes y los comentarios dejan de
#             reconocer a quien ya comentó.
APP_KEY=
HASH_PEPPER=

# La ruta del panel. Cambiala: es lo que hacía wps-hide-login, y lo que evita
# que el 100% de los bots que prueban /wp-login.php encuentren algo.
ADMIN_PATH=/panel

DB_DSN=mysql:host=127.0.0.1;dbname=nerdo_cms;charset=utf8mb4
DB_USER=
DB_PASS=

SESSION_NAME=ncms
SESSION_IDLE=7200
SESSION_ABSOLUTE=86400

# PHP y MariaDB comparten esta zona horaria: el offset se le fija a la base en
# cada conexión. Si se desacoplan se rompen, en silencio, las entradas
# programadas, el vencimiento de sesiones y las ventanas del límite de tasa.
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Solo en true si hay un proxy inverso propio adelante. Con esto en true y sin
# proxy, cualquiera manda X-Forwarded-For y se saltea el límite de tasa.
TRUST_PROXY=false
